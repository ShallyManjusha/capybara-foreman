# Capybara Foreman — environment configuration template.
# Copy to .env and fill in the values. Real env vars always win over this file.
#
#   cp .env.example .env && chmod 600 .env
#
# Values with spaces must be quoted. Keep this file out of source control.

# ──────────────────────────────────────────────────────────────────────────────
# Bob Shell
# ──────────────────────────────────────────────────────────────────────────────

# Bob Shell 2.x API key. Set both so one file works across a fleet mid-upgrade.
BOB_API_KEY=
# Bob Shell 1.0.x API key.
BOBSHELL_API_KEY=
# Required for 2.x when using a general-type API key (find on your team page).
BOB_TEAM_ID=
# Pin the model before measuring anything. Unpinned means budgets describe a
# system you are no longer running.
FOREMAN_MODEL=

# ──────────────────────────────────────────────────────────────────────────────
# Jira
# ──────────────────────────────────────────────────────────────────────────────

# Cloud:       your-domain.atlassian.net
# Data Center: http://jira.corp:8080/jira  (full base URL, inc. scheme and port)
JIRA_SITE=
# Cloud: your email address. Data Center: leave empty (uses bearer auth).
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: force "cloud" or "datacenter". Default "auto" detects from /serverInfo.
JIRA_DEPLOYMENT=auto
# Project key Foreman creates tickets in and operates against.
JIRA_PROJECT=FORE
# Tickets that match this query are picked up on each run.
# Exclude prod-deployment: Foreman raises those itself and must not re-triage them.
JIRA_INTAKE_JQL="project = FORE AND labels in (foreman, foreman-requirement) AND labels not in (prod-deployment, foreman-blocked) AND statusCategory != Done"

# ──────────────────────────────────────────────────────────────────────────────
# Approvers — account IDs or emails, comma-separated.
# An empty list means NOBODY can approve. That is deliberate.
# ──────────────────────────────────────────────────────────────────────────────
FOREMAN_APPROVERS=

# ──────────────────────────────────────────────────────────────────────────────
# Write interlocks — BOTH must be set to act on a real board.
# ──────────────────────────────────────────────────────────────────────────────

# Must be "true" in addition to the --live CLI flag for any writes to happen.
FOREMAN_WRITE=false
# Set "true" to let Foreman auto-merge the PR after sign-off.
FOREMAN_AUTO_MERGE=false

# ──────────────────────────────────────────────────────────────────────────────
# Git
# ──────────────────────────────────────────────────────────────────────────────

# "local" for the sandbox (no tokens needed). "github" for a real repository.
FOREMAN_GIT_MODE=local
# Path to the local sandbox repo (used when FOREMAN_GIT_MODE=local).
FOREMAN_LOCAL_REPO=./var/sandbox/service

# GitHub — only required when FOREMAN_GIT_MODE=github.
GITHUB_REPO=
# Read token (analysis tier — no write access).
GITHUB_READ_TOKEN=
# Write token (build tier — pushes branches and opens PRs).
GITHUB_WRITE_TOKEN=
# Override if using GitHub Enterprise Server.
GITHUB_HOST=github.com
GITHUB_API=https://api.github.com
# Branch to open PRs against.
FOREMAN_BASE_BRANCH=main
FOREMAN_BRANCH_PREFIX=foreman/
# Labels to add to opened PRs (comma-separated).
FOREMAN_PR_LABELS=

# Git identity used for commits.
FOREMAN_GIT_NAME="Capybara Foreman"
FOREMAN_GIT_EMAIL=foreman@example.com

# ──────────────────────────────────────────────────────────────────────────────
# Deployment
# ──────────────────────────────────────────────────────────────────────────────

# simulated | github-actions | webhook | none
FOREMAN_DEPLOY_MODE=simulated
# github-actions: the workflow file name on FOREMAN_DEPLOY_REF.
FOREMAN_DEPLOY_WORKFLOW=
FOREMAN_DEPLOY_REF=main
FOREMAN_DEPLOY_ENV=nonprod
# webhook: URL to POST to.
FOREMAN_DEPLOY_WEBHOOK=

# ──────────────────────────────────────────────────────────────────────────────
# Testing
#
# Two commands, because they run at different times:
#   FOREMAN_BUILD_TEST_COMMAND  before a branch is published (build stage). Must
#                               not need a deployed environment. Unset = use
#                               FOREMAN_TEST_COMMAND; set to "" to skip.
#   FOREMAN_TEST_COMMAND        against DEV, after the deploy (bob-ace-testing-kit).
# The harness only checks the exit code (0 = pass).
# ──────────────────────────────────────────────────────────────────────────────

FOREMAN_TEST_COMMAND="python3 -m pytest -q"
# FOREMAN_TEST_COMMAND="bob-ace-test run --config ace-test.yaml --format junit"
# FOREMAN_BUILD_TEST_COMMAND=

# ──────────────────────────────────────────────────────────────────────────────
# Jira production-deployment ticket settings
# ──────────────────────────────────────────────────────────────────────────────

FOREMAN_PROD_ISSUETYPE=Task
FOREMAN_PROD_FIXVERSION=

# ──────────────────────────────────────────────────────────────────────────────
# Gate commands (defaults shown — change only if your Jira comment conventions differ)
# ──────────────────────────────────────────────────────────────────────────────

FOREMAN_CMD_APPROVE="/foreman approve"
FOREMAN_CMD_REJECT="/foreman reject"
FOREMAN_CMD_CHANGES="/foreman changes"

# ──────────────────────────────────────────────────────────────────────────────
# Run limits
# ──────────────────────────────────────────────────────────────────────────────

# Max tickets to process per run (start low during a pilot).
FOREMAN_MAX_TICKETS=5
# Max times a ticket can loop through plan → revise before it is stalled.
FOREMAN_MAX_REVISIONS=3

# ──────────────────────────────────────────────────────────────────────────────
# Tapestry extensions — Intake sources
# ──────────────────────────────────────────────────────────────────────────────

# --- Jira Business Requirement board (jira-br source) ---
# JQL to find requirements in the source board.
# Example: project = BR AND issuetype = Story AND labels = tapestry AND statusCategory != Done
INTAKE_JIRA_SOURCE_JQL=
# Label applied to source tickets after mirroring (prevents re-import).
INTAKE_JIRA_DONE_LABEL=foreman-imported

# --- ServiceNow (servicenow source) ---
# ServiceNow instance host (without https://), e.g. dev12345.service-now.com
SNOW_INSTANCE=
SNOW_USER=
SNOW_PASSWORD=
# Encoded query to select incidents for import.
# Example: state=1^category=integration^assignment_group=tapestry
SNOW_INTAKE_QUERY=state=1
# OPTIONAL: incident state to set after import (e.g. 2 = In Progress), with a
# work note naming the Jira key. Leave empty to leave the incident untouched.
# Do NOT use 6 (Resolved): importing a requirement is not fixing it. Duplicates are
# prevented by a src-<hash> label on the Jira issue, not by changing ServiceNow.
SNOW_DONE_STATE=
# Max incidents to import per run.
SNOW_MAX_RECORDS=10

# --- Email / IMAP (email source) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Mailbox folder to watch for new requirement emails.
IMAP_FOLDER=INBOX
# Max unread messages to process per run.
IMAP_MAX_MSGS=10

# Jira issue type used when creating intake issues from external sources.
FOREMAN_INTAKE_ISSUETYPE=Task

# ──────────────────────────────────────────────────────────────────────────────
# Tapestry — requirement → Feature / Epic / Story
# ──────────────────────────────────────────────────────────────────────────────

# Issue types. Set FOREMAN_FEATURE_ISSUETYPE=none if your project has no Feature type.
FOREMAN_FEATURE_ISSUETYPE=Feature
FOREMAN_EPIC_ISSUETYPE=Epic
FOREMAN_STORY_ISSUETYPE=Story
# Jira Data Center / classic projects link a child to its parent through a custom
# field whose id is different on every instance (e.g. customfield_10014 = Epic Link).
# Leave empty on Jira Cloud (the `parent` field is used).
FOREMAN_EPIC_LINK_FIELD=
FOREMAN_FEATURE_LINK_FIELD=
# Data Center: the mandatory "Epic Name" custom field, if your Epic type has one.
FOREMAN_EPIC_NAME_FIELD=

# Intake JQL must pick up requirements AND the stories Foreman works, and must
# NOT pick up the stories people work. Foreman-owned stories carry `foreman`;
# stories waiting on another carry `foreman-blocked` until released.
#   JIRA_INTAKE_JQL="project = FORE AND labels in (foreman, foreman-requirement) AND labels not in (prod-deployment, foreman-blocked) AND statusCategory != Done"
# A requirement stays open (state `tracking`) until all its stories are Done, so it
# must remain matched while open -- the JQL above does that.

# ──────────────────────────────────────────────────────────────────────────────
# Tapestry — TapiForge mappings
#   FOREMAN_MAPPING_MODE: mcp (read, and write if write tools are listed) | file
#   (Excel/JSON diff attached to the story; a person applies it). Default: mcp when
#   a server is configured, else file.
# ──────────────────────────────────────────────────────────────────────────────

FOREMAN_MAPPING_MODE=
# Remote server (set the URL) ...
TAPIFORGE_MCP_URL=
# http = streamable HTTP, sse = legacy SSE
TAPIFORGE_MCP_TRANSPORT=http
TAPIFORGE_MCP_TOKEN=
TAPIFORGE_MCP_AUTH_HEADER=Authorization
TAPIFORGE_MCP_AUTH_SCHEME=Bearer
# ... or a local server (set the command).
TAPIFORGE_MCP_COMMAND=
TAPIFORGE_MCP_ARGS=
# KEY=value,KEY2=value2 -- credentials for the MCP server process itself.
TAPIFORGE_MCP_ENV=
TAPIFORGE_MCP_TIMEOUT_MS=
# Tool names, comma-separated, exactly as TapiForge lists them. Read tools are
# auto-approved while drafting; write tools only after the human gate.
# Leave write tools empty and a person applies the changes (Option 2).
TAPIFORGE_MCP_READ_TOOLS=
TAPIFORGE_MCP_WRITE_TOOLS=

# ──────────────────────────────────────────────────────────────────────────────
# Tapestry — merge to DEV, then CP4i / OKD rollout
#   FOREMAN_BASE_BRANCH is the DEV branch (e.g. Release_DEV): PRs target it, and the
#   merge to it is what starts your pipeline.
# ──────────────────────────────────────────────────────────────────────────────

# true: Foreman merges after Gate 3. false: a person merges; Foreman waits.
# FOREMAN_AUTO_MERGE=true
FOREMAN_MERGE_METHOD=squash
# FOREMAN_DEPLOY_MODE=okd
FOREMAN_OKD_NAMESPACE=
FOREMAN_OKD_LABEL_SELECTOR=
# Pods created before the merge do not count as the new version.
FOREMAN_OKD_REQUIRE_NEW_PODS=true
# Seconds of clock skew allowed between this host and the cluster.
FOREMAN_OKD_CLOCK_SKEW_SEC=30
FOREMAN_OKD_POD_TIMEOUT_SEC=900
FOREMAN_OC_BINARY=oc
